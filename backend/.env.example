PORT=5000
JWT_SECRET=apna-koi-bhi-random-strong-string-yahan-daalo
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=AdminKaPasswordYahan

# Razorpay — razorpay.com/dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=webhook-secret-from-razorpay-dashboard

# MSG91 SMS OTP — msg91.com -> OTP -> API Keys
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# Gmail — Google Account -> Security -> App Passwords
EMAIL_USER=tumhara-email@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Google OAuth — console.cloud.google.com -> Credentials
GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com

# Business Info
BUSINESS_PHONE=+91 XXXXXXXXXX
BUSINESS_EMAIL=info@tumharadomain.com
BUSINESS_GSTIN=XXXXXXXXXXXXXXX

# Production Domain (hosting pe daalne ke baad update karo)
FRONTEND_URL=https://staydekho.com

# This backend's own public URL — used for links to pages THIS server
# renders (invoice/payout), which don't exist on the static frontend.
API_URL=https://api.staydekho.com

# WhatsApp Cloud API — Meta Business Manager -> WhatsApp -> API Setup
# Phone Number ID: graph.facebook.com/v19.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_PHONE_NUMBER_ID=XXXXXXXXXXXXXXXXX
# Permanent Token: Meta -> System Users -> Generate Token (whatsapp_business_messaging permission)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxx
# Template language code (en = English, hi = Hindi)
WHATSAPP_LANG=en
# Any random string you make up yourself — must match EXACTLY what you enter
# in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook -> Verify token
WHATSAPP_VERIFY_TOKEN=koi-bhi-random-secret-string-yahan
